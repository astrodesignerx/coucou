<?xml version="1.0" encoding="utf-8"?>
<!--
  Application (fusion) manifest fragment that connects the Choom executable to
  the identity package. The msix element attributes must match the identity
  package manifest exactly: publisher equals Identity@Publisher, packageName
  equals Identity@Name, applicationId equals Application@Id.

  Set CHOOM_IDENTITY=1 for a build that embeds this manifest. Ordinary builds
  retain Tauri's default manifest. This does not register a package.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="0.0.0.0" name="Choom" />
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0" processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df" language="*" />
    </dependentAssembly>
  </dependency>
  <msix xmlns="urn:schemas-microsoft-com:msix.v1"
        publisher="CN=Choom"
        packageName="Choom"
        applicationId="Choom" />
</assembly>
