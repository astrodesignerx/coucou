{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Choom",
  "mainBinaryName": "Choom",
  "version": "0.1.7",
  "identifier": "com.astrodesignerx.choom",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    },
    "windows": [
      {
        "label": "island",
        "title": "Choom",
        "url": "index.html",
        "width": 240,
        "height": 6,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": true,
        "center": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/128x128.png": "Assets/storelogo.png",
      "../target/release/coucou-hook.exe": "coucou-hook.exe",
      "../voice-runtime/choom-voice.ps1": "choom-voice.ps1",
      "../voice-runtime/whisper/whisper-cli.exe": "whisper/whisper-cli.exe",
      "../voice-runtime/whisper/whisper.dll": "whisper/whisper.dll",
      "../voice-runtime/whisper/ggml.dll": "whisper/ggml.dll",
      "../voice-runtime/whisper/ggml-base.dll": "whisper/ggml-base.dll",
      "../voice-runtime/whisper/ggml-cpu-alderlake.dll": "whisper/ggml-cpu-alderlake.dll",
      "../voice-runtime/whisper/ggml-cpu-cannonlake.dll": "whisper/ggml-cpu-cannonlake.dll",
      "../voice-runtime/whisper/ggml-cpu-cascadelake.dll": "whisper/ggml-cpu-cascadelake.dll",
      "../voice-runtime/whisper/ggml-cpu-haswell.dll": "whisper/ggml-cpu-haswell.dll",
      "../voice-runtime/whisper/ggml-cpu-icelake.dll": "whisper/ggml-cpu-icelake.dll",
      "../voice-runtime/whisper/ggml-cpu-sandybridge.dll": "whisper/ggml-cpu-sandybridge.dll",
      "../voice-runtime/whisper/ggml-cpu-skylakex.dll": "whisper/ggml-cpu-skylakex.dll",
      "../voice-runtime/whisper/ggml-cpu-sse42.dll": "whisper/ggml-cpu-sse42.dll",
      "../voice-runtime/whisper/ggml-cpu-x64.dll": "whisper/ggml-cpu-x64.dll",
      "../voice-runtime/whisper/ggml-base.bin": "whisper/ggml-base.bin",
      "../voice-runtime/whisper/LICENSE-whisper.txt": "whisper/LICENSE-whisper.txt",
      "../voice-runtime/whisper/LICENSE-ggml.txt": "whisper/LICENSE-ggml.txt",
      "../voice-runtime/whisper/LICENSE-model.txt": "whisper/LICENSE-model.txt"
    },
    "copyright": "© Louis Raille",
    "category": "DeveloperTool",
    "shortDescription": "Choom lives at the top of your screen",
    "longDescription": "Choom lives at the top of your screen: it shows your Claude Code sessions and a few integrations, and lets you approve, answer, chat and drop files without leaving what you are doing.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "French"],
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
