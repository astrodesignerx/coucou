{
  "name": "coucou-windows",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --import ./tests/setup.mjs --test \"tests/**/*.test.mjs\"",
    "icons": "node scripts/gen-icons.mjs",
    "tauri": "tauri",
    "predev": "node scripts/fetch-whisper.mjs && cargo build --release -p coucou-hook",
    "prebuild": "node scripts/fetch-whisper.mjs && cargo build --release -p coucou-hook",
    "selftest": "node scripts/tools-selftest.cjs",
    "pack": "tauri build && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.6.0",
    "vite": "^6"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  }
}
